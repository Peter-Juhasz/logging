root = true

[*]
end_of_line = crlf
tab_width = 4
indent_style = tab
max_line_length = 320
charset = utf-8-bom

[.github/**.md]
charset = utf-8

[*.{csproj,vbproj,props,slnx}]

[*.json]
charset = utf-8

[*.{yml,yaml}]
tab_width = 2
indent_size = 2
indent_style = space

[*.{cs,vb,fs}]
csharp_style_namespace_declarations = file_scoped:warning

# IDE0017: Simplify object initialization
dotnet_style_object_initializer = false:suggestion

# IDE0028: Simplify collection initialization
dotnet_style_collection_initializer = false:suggestion

dotnet_diagnostic.CS9107.severity = none

# The given expression is never of the provided type
dotnet_diagnostic.CS0184.severity = error

[tests/**.cs]
# MSTest discovers public test classes.
dotnet_diagnostic.CA1515.severity = none
# Test method names are descriptive sentences with underscores.
dotnet_diagnostic.CA1707.severity = none
# Test data is declared inline.
dotnet_diagnostic.CA1861.severity = none

[benchmarks/**.cs]
# BenchmarkDotNet requires public benchmark classes.
dotnet_diagnostic.CA1515.severity = none
# Benchmark methods must be instance methods.
dotnet_diagnostic.CA1822.severity = none
